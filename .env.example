# ============================================================
# CẤU HÌNH MÔI TRƯỜNG
# Copy file này thành .env.local rồi điền giá trị thật
# ============================================================

# URL Google Apps Script nhận form RSVP
# Payload: { name, phone, attendance: "YES"|"NO", guestCount, message }
RSVP_API_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Hoặc dùng biến public (fallback nếu không có RSVP_API_URL)
# NEXT_PUBLIC_RSVP_API=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Domain website khi deploy (vd: https://cuoianhduong.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
